# LLM Configuration (optional - for vision-based analysis)
COMET_API_KEY=your_api_key_here
COMET_BASE_URL=https://api.cometapi.com/v1
COMET_MODEL=gpt-4o
COMET_REASONING=xhigh

# Cookie Configuration (optional - for authenticated access)
