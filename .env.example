# Liquidation Heatmap MCP Server Environment Variables

# ==========================================
# LLM API Configuration (Optional)
# ==========================================
# CometAPI key for LLM-based analysis
# If not set, only algo mode will be available
COMET_API_KEY=

# API base URL (OpenAI-compatible)
COMET_BASE_URL=https://api.cometapi.com/v1

# Model to use for vision analysis
COMET_MODEL=gpt-5.2

# Reasoning effort level (xhigh, high, medium, low)
# Will auto-downgrade if not supported
COMET_REASONING=xhigh

# ==========================================
# Cookie Configuration (Optional)
# ==========================================
# Cookies for authenticated access to data sources
# Format: "key1=value1; key2=value2"
COINGLASS_COOKIE=
COINANK_COOKIE=

# ==========================================
# Cache and Debug Settings
# ==========================================
# Directory for screenshot cache
SCREENSHOT_CACHE_DIR=/tmp/liq-heatmap

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Save debug images (0=disabled, 1=enabled)
# When enabled, saves full and cropped screenshots for debugging
DEBUG_CROP=0
